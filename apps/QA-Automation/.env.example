# Copy this file to .env and set values for your environment.

# Environment
ENV_NAME=test

# React app URL (this product UI — not the legacy RITeSchool schoolwebsiteui host)
BASE_URL=https://erpui.aaditechnology.com/

# Tenant / school (exact name as shown in the Select School dropdown)
TENANT=
SCHOOL_NAME=

# Login credentials — LOGIN_USERNAME is the account email (do not use USERNAME — Windows reserves that variable)
# System admin (CampusAdmin) logs in without school selection
LOGIN_USERNAME=aaditechology@gmail.com
LOGIN_PASSWORD=Test@123

# Browser: chromium | firefox | webkit
BROWSER=chromium

# Headless: true | false
HEADLESS=false
