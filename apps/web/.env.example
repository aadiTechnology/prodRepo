# Copy this file to .env, .env.development, or .env.production and set values
# for your environment. Vite only exposes variables prefixed with VITE_.

# API used by the web app (no trailing slash required)
# Local FastAPI: http://127.0.0.1:8022
# Production:    https://erpapi.aaditechnology.com
VITE_API_BASE_URL=http://127.0.0.1:8022

# Display name and version shown in the UI
VITE_APP_NAME=Preschool ERP
VITE_APP_VERSION=1.0.0

# Hostnames that keep manual school selection on login (comma-separated)
VITE_LOGIN_DEFAULT_HOSTS=localhost,127.0.0.1
