# ============================================================
# Contabo React deploy config  (copy this file to contabo.env)
# ============================================================
#
# Used by:  apps\web\deployReact2Contabo.bat
#
# Setup:
#   1. Copy this file to  apps\web\config\contabo.env
#   2. Fill in real values (contabo.env is gitignored; do not commit it)
#   3. Run deployReact2Contabo.bat
#
# This BAT deploys ONE React/Vite app per run onto the shared Contabo
# Caddy proxy. To deploy another app, change only the PER-APP block.
# Do not clone the BAT.
#
# Architecture:
#   Internet -> Caddy :80/:443 (HTTPS / Let's Encrypt)
#            -> Docker network
#            -> this app's container :80  (published only as 127.0.0.1:HOST_PORT)
#
# Rules:
#   - Lines starting with # are comments
#   - No spaces around =
#   - Do not wrap values in quotes
#   - DNS for REACT_DOMAIN must already point at CONTABO_IP before HTTPS works
#
# Current verified prod example (do not reuse these names/ports for a new app):
#   REACT_DOMAIN=erpui2.aaditechnology.com
#   REACT_CONTAINER_NAME=prodrepo-web
#   REACT_HOST_PORT=3000
#   Protected existing Caddy site: aifactorytest.aaditechnology.com
# ============================================================


# ============================================================
# COMMON  - server + existing Caddy
# Change these when the server or proxy changes, not when adding an app.
# Test and prod may use different servers; copy this whole block per env.
# ============================================================

# Public IP (or hostname) of the Contabo VM. Plink SSH target.
CONTABO_IP=YOUR_SERVER_IP

# SSH login user. Usually root on this Contabo image.
CONTABO_USER=root

# SSH password for CONTABO_USER. Never commit the real value.
CONTABO_SSH_PASSWORD=YOUR_SSH_PASSWORD

# SSH host key fingerprint (SHA256:...). Required; Plink refuses unknown hosts.
# Get it once from a trusted first connection, or:
#   plink -ssh CONTABO_USER@CONTABO_IP
# then copy the SHA256 fingerprint it prints.
CONTABO_SSH_HOSTKEY=SHA256:YOUR_HOST_FINGERPRINT

# Running Caddy reverse-proxy container. Owns public 80/443.
# Do not point this at a React container. Default if omitted: factory-test-proxy-1
CADDY_CONTAINER_NAME=factory-test-proxy-1

# Host path bind-mounted into Caddy as /etc/caddy/Caddyfile (read-only).
# The BAT appends this app's site block here; it never replaces Caddy.
# Default if omitted: /opt/factory-test/infrastructure/docker/Caddyfile
CADDYFILE_PATH=/opt/factory-test/infrastructure/docker/Caddyfile

# Existing HTTPS site that MUST keep working after this deploy.
# The BAT fails if this URL does not return HTTP 200.
# Default if omitted: aifactorytest.aaditechnology.com
CADDY_EXISTING_DOMAIN=aifactorytest.aaditechnology.com


# ============================================================
# PER-APP  - change this block for each React app / each env
# ============================================================
# Every app on the same server needs UNIQUE:
#   GITHUB_REPO          (unless two envs share a repo and differ by branch)
#   REACT_APP_DIR
#   REACT_CONTAINER_NAME
#   REACT_IMAGE_NAME
#   REACT_HOST_PORT
#   REACT_DOMAIN
#
# Suggested naming:
#   test:  /opt/apps/myapp-test    myapp-test-web    port 3001    myapp-test.example.com
#   prod:  /opt/apps/myapp         myapp-web         port 3002    myapp.example.com
#
# Ports already in use on the current server (do not reuse):
#   3000 = prodrepo-web (erpui2.aaditechnology.com)
# ============================================================

# Git clone URL. Server must be able to fetch this (public, or deploy key on the VM).
GITHUB_REPO=https://github.com/YOUR_ORG/YOUR_REPO.git

# Branch to deploy. Script does: checkout + reset --hard origin/BRANCH
# Examples: development (test), main (prod)
GITHUB_BRANCH=development

# Absolute directory on the Contabo server where the repo is cloned.
# First run clones here; later runs fetch/reset in place.
# Use a different path per app so one deploy cannot overwrite another repo.
REACT_APP_DIR=/opt/apps/YOUR_APP

# Path to the frontend (Dockerfile + nginx.conf) relative to REACT_APP_DIR.
# This repo uses apps/web. Use . if Dockerfile is at the repo root.
# Default if omitted: apps/web
REACT_FRONTEND_DIR=apps/web

# Docker container name. Caddy reverse_proxies to this name on the Docker network.
# Must be unique. Must NOT start with factory-test- (those are protected).
REACT_CONTAINER_NAME=yourapp-web

# Docker image name (tagged :latest). Must be unique; do not rebuild another app's image.
REACT_IMAGE_NAME=yourapp-web

# Host port published as 127.0.0.1:REACT_HOST_PORT -> container 80.
# Private only; the public URL is REACT_DOMAIN through Caddy.
# Must be unique on this server. Do not pick a random port automatically.
REACT_HOST_PORT=3001

# Port inside the React container. Keep 80 unless the image listens elsewhere.
REACT_CONTAINER_PORT=80

# Public hostname Caddy will serve with automatic HTTPS.
# Create DNS A record to CONTABO_IP before deploying.
# Example test:  yourapp-test.aaditechnology.com
# Example prod:  yourapp.aaditechnology.com
REACT_DOMAIN=yourapp.aaditechnology.com


# ============================================================
# PER-APP VITE  - baked into the production JS at docker build
# Changing these requires a rebuild/redeploy. They are not runtime env vars.
# ============================================================

# Backend API base URL compiled into the frontend.
# Test and prod should usually point at different APIs.
VITE_API_BASE_URL=https://yourapp-api.aaditechnology.com

# Browser tab / product name shown in the built app.
# Default if omitted: Preschool ERP
VITE_APP_NAME=Your App Name

# Version string compiled into the build.
# Default if omitted: 1.0.0
VITE_APP_VERSION=1.0.0

# Comma-separated hosts allowed as login defaults (no spaces).
# Default if omitted: localhost,127.0.0.1
VITE_LOGIN_DEFAULT_HOSTS=localhost,127.0.0.1
